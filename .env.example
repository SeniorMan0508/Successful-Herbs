# Server Port
PORT=3000

# Initial Admin PIN (must be at least 6 characters; hashed with bcrypt on first startup)
ADMIN_INITIAL_PIN=change_this_to_a_strong_6_plus_char_pin

# Optional: Custom paths for persistent storage (e.g., Render Disk mounted at /var/data)
# DATA_DIR=/var/data/db
# UPLOADS_DIR=/var/data/uploads
