# Server Port
PORT=3000

# Initial Admin PIN (must be at least 6 characters; hashed with bcrypt on first startup)
ADMIN_INITIAL_PIN=change_this_to_a_strong_6_plus_char_pin

# Turso Database Configuration
TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Cloudinary Image Storage Configuration
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
